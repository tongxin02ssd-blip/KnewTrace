generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  UPLOADING
  PARSING
  CHUNKING
  EMBEDDING
  INDEXING
  INDEXED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

enum ToolStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum EvidenceSourceType {
  KNOWLEDGE
  WEB
}

model KnowledgeBase {
  id          String      @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  documents   Document[]
  threads     Thread[]
  runs        AgentRun[]
}

model Document {
  id              String         @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  fileName        String
  fileType        String
  fileSize        Int
  storagePath     String
  status          DocumentStatus @default(UPLOADING)
  pageCount       Int?
  chunkCount      Int            @default(0)
  error           Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  chunks          Chunk[]
  evidence        Evidence[]

  @@index([knowledgeBaseId, status])
}

model Chunk {
  id         String     @id @default(cuid())
  documentId String
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  page       Int?
  section    String?
  chunkIndex Int
  metadata   Json?
  embedding Unsupported("vector")?
  evidence   Evidence[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model Thread {
  id              String        @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  title           String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  messages        Message[]
  runs            AgentRun[]

  @@index([knowledgeBaseId, updatedAt])
}

model Message {
  id        String      @id @default(cuid())
  threadId  String
  thread    Thread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  runId     String?
  createdAt DateTime    @default(now())
  userRun   AgentRun?   @relation("UserMessage")
  citations Citation[]

  @@index([threadId, createdAt])
}

model AgentRun {
  id              String        @id @default(cuid())
  threadId        String
  thread          Thread        @relation(fields: [threadId], references: [id], onDelete: Cascade)
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  userMessageId   String        @unique
  userMessage     Message       @relation("UserMessage", fields: [userMessageId], references: [id])
  parentRunId     String?
  parentRun       AgentRun?     @relation("RunRetries", fields: [parentRunId], references: [id])
  retries         AgentRun[]    @relation("RunRetries")
  status          RunStatus     @default(QUEUED)
  currentNode     String?
  retrievalRound  Int           @default(0)
  state           Json?
  approval        Json?
  startedAt       DateTime      @default(now())
  completedAt     DateTime?
  error           Json?
  events          AgentEvent[]
  tools           ToolExecution[]
  evidence        Evidence[]
  citations       Citation[]

  @@index([threadId, startedAt])
  @@index([knowledgeBaseId, startedAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  seq       Int
  type      String
  node      String?
  payload   Json
  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId, seq])
}

model ToolExecution {
  id            String     @id @default(cuid())
  runId         String
  run           AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolName      String
  status        ToolStatus @default(RUNNING)
  input         Json
  outputSummary String?
  error         Json?
  startedAt     DateTime   @default(now())
  completedAt   DateTime?
  evidence      Evidence[]

  @@index([runId, startedAt])
}

model Evidence {
  id              String             @id @default(cuid())
  runId           String
  run             AgentRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceType      EvidenceSourceType
  documentId      String?
  document        Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  chunkId         String?
  chunk            Chunk?             @relation(fields: [chunkId], references: [id], onDelete: SetNull)
  url             String?
  title           String
  excerpt         String
  score           Float?
  retrievalQuery  String
  toolExecutionId String?
  toolExecution   ToolExecution?     @relation(fields: [toolExecutionId], references: [id], onDelete: SetNull)
  createdAt       DateTime           @default(now())
  citations       Citation[]

  @@index([runId, createdAt])
}

model Citation {
  id          String   @id @default(cuid())
  runId       String
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  evidenceId  String
  evidence    Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  marker      Int
  answerStart Int?
  answerEnd   Int?
  createdAt   DateTime @default(now())

  @@unique([runId, marker])
  @@index([messageId])
}
