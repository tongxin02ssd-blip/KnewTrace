DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowtrace?schema=public"
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

# OpenAI-compatible chat completion endpoint
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Embeddings. Volcengine Ark uses its multimodal endpoint for this model.
EMBEDDING_PROVIDER=volcengine
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215
EMBEDDING_DIMENSIONS=1024
# Maximum number of single-text Ark embedding requests in flight.
EMBEDDING_CONCURRENCY=6

# Tavily Search API
WEB_SEARCH_API_KEY=
